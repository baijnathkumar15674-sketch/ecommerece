@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #20243a;
  background: #f7f8fc;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-optical-sizing: auto;
  font-weight: 400;
  --primary: #635bdb;
  --primary-dark: #5048c4;
  --muted: #858ba1;
  --border: #e9ebf3;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; min-height: 100vh; }
button, input { font: inherit; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: .65; }
a { color: inherit; text-decoration: none; }
.muted { color: var(--muted); font-size: 13px; margin: 7px 0 0; }
.eyebrow { color: var(--primary); font-size: 10px; letter-spacing: 1.5px; font-weight: 700; margin: 0 0 9px; }
.muted-icon { color: #a1a5b5; }

.app-shell { min-height: 100vh; display: flex; }
.sidebar {
  width: 248px; flex: 0 0 248px; background: #fff; border-right: 1px solid var(--border);
  display: flex; flex-direction: column; padding: 25px 17px 18px; min-height: 100vh;
}
.brand { display: flex; align-items: center; gap: 11px; padding: 0 9px 35px; }
.brand-mark {
  display: grid; place-items: center; width: 39px; height: 39px; border-radius: 12px;
  background: linear-gradient(145deg, #766ef1, #5148c5); color: #fff; font: 800 23px Manrope, sans-serif;
  box-shadow: 0 5px 14px #635bdb35;
}
.brand strong { display: block; font: 800 20px Manrope, sans-serif; letter-spacing: -.7px; }
.brand span { display: block; margin-top: 3px; font-size: 9px; letter-spacing: 1.6px; color: #9a9eb1; font-weight: 700; }
.nav-heading { color: #a3a7b8; font-size: 10px; letter-spacing: 1.3px; font-weight: 700; padding: 0 12px; margin: 0 0 12px; }
.navigation { display: grid; gap: 5px; }
.nav-link { display: flex; align-items: center; gap: 12px; padding: 12px; border-radius: 9px; color: #777e95; font-size: 13px; font-weight: 600; }
.nav-link svg { color: #9ba0b4; }
.nav-link:hover { background: #f8f8fe; color: var(--primary); }
.nav-link.active { background: #f0efff; color: var(--primary); }
.nav-link.active svg { color: var(--primary); }
.nav-count { margin-left: auto; font-size: 11px; background: #e5e3ff; color: var(--primary); padding: 3px 7px; border-radius: 6px; }
.sidebar-bottom { margin-top: auto; }
.sidebar-bottom > .nav-heading { margin-top: 30px; }
.sidebar-status { margin: 24px 6px 15px; padding: 13px 10px; display: flex; align-items: flex-start; gap: 9px; background: #f7f8fc; border-radius: 9px; }
.status-dot { width: 7px; height: 7px; background: #30bd85; border-radius: 50%; margin-top: 4px; box-shadow: 0 0 0 3px #30bd851c; }
.sidebar-status strong, .sidebar-status span { display: block; }
.sidebar-status strong { font-size: 11px; }
.sidebar-status div span { color: var(--muted); font-size: 9px; margin-top: 4px; }
.logout-button { width: 100%; display: flex; align-items: center; gap: 11px; border: 0; background: transparent; color: #777e95; padding: 12px; font-size: 13px; }
.logout-button:hover { color: #d84f65; }

.main-panel { min-width: 0; flex: 1; }
.topbar { height: 91px; display: flex; align-items: center; justify-content: space-between; background: #fff; border-bottom: 1px solid var(--border); padding: 0 35px; }
.topbar-left, .topbar-actions { display: flex; align-items: center; gap: 13px; }
.breadcrumb { font-size: 11px; color: #a0a4b5; margin: 0 0 5px; }
.topbar h1 { font: 700 19px Manrope, sans-serif; margin: 0; letter-spacing: -.4px; }
.topbar-actions { gap: 16px; }
.admin-label { font-size: 12px; color: #777e95; }
.icon-button { display: grid; place-items: center; background: transparent; border: 0; color: #8389a0; width: 35px; height: 35px; border-radius: 9px; }
.icon-button:hover { background: #f2f2fa; }
.notification-button { border: 1px solid var(--border); }
.avatar { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: #5b53cb; background: #eae8ff; font-weight: 700; font-size: 13px; }
.mobile-menu, .mobile-close { display: none; }

.page-content { max-width: 1600px; padding: 32px 35px 20px; margin: 0 auto; }
.welcome-row { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 25px; }
.welcome-row h2 { font: 800 25px Manrope, sans-serif; letter-spacing: -.8px; margin: 0; }
.primary-button, .secondary-button { border-radius: 8px; padding: 10px 14px; font-size: 12px; font-weight: 700; display: inline-flex; justify-content: center; align-items: center; gap: 8px; }
.secondary-button { color: #646b83; background: #fff; border: 1px solid #e5e7f0; box-shadow: 0 2px 5px #20243a04; }
.secondary-button:hover { border-color: #c8c5fb; color: var(--primary); }
.primary-button { border: 0; color: #fff; background: var(--primary); }
.primary-button:hover { background: var(--primary-dark); }
.alert-banner { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: #fff2f0; color: #b54743; padding: 12px 15px; border-radius: 9px; font-size: 12px; margin-bottom: 18px; }
.alert-banner button { border: 0; background: transparent; color: inherit; text-decoration: underline; font-weight: 700; }

.stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 17px; margin-bottom: 25px; }
.stat-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 19px; min-width: 0; box-shadow: 0 3px 10px #24294b03; }
.stat-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: #777e95; font-size: 12px; }
.stat-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; flex: 0 0 auto; }
.purple { color: #665de0; background: #f0efff; }
.green { color: #20a778; background: #e9faf3; }
.orange { color: #d98b37; background: #fff4e6; }
.blue { color: #3c8edb; background: #eaf5ff; }
.stat-value { display: block; font: 800 26px Manrope, sans-serif; letter-spacing: -.8px; margin-top: 15px; overflow-wrap: anywhere; }
.stat-caption { display: flex; align-items: center; gap: 5px; color: #9a9fb0; font-size: 10px; margin-top: 9px; }

.orders-panel { background: #fff; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: 0 3px 10px #24294b03; }
.panel-heading { display: flex; justify-content: space-between; align-items: center; padding: 23px 23px 19px; }
.panel-heading h2 { font: 700 16px Manrope, sans-serif; margin: 0; }
.orders-badge { font-size: 10px; font-weight: 700; color: var(--primary); background: #f0efff; padding: 7px 10px; border-radius: 7px; }
.table-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 0 23px 17px; }
.search-box { display: flex; align-items: center; gap: 9px; width: min(390px, 100%); border: 1px solid #e8eaf2; border-radius: 8px; padding: 0 11px; height: 38px; color: #a0a5b6; }
.search-box:focus-within { border-color: #aaa5f5; box-shadow: 0 0 0 3px #635bdb10; }
.search-box input { min-width: 0; width: 100%; border: 0; outline: 0; color: #33384e; background: transparent; font-size: 11px; }
.search-box input::placeholder { color: #a0a5b6; }
.table-count { font-size: 10px; white-space: nowrap; }
.table-scroll { width: 100%; overflow-x: auto; }
table { border-collapse: collapse; width: 100%; text-align: left; }
thead { background: #fafbfe; }
th { color: #989db0; font-size: 9px; letter-spacing: .8px; font-weight: 700; padding: 13px 18px; white-space: nowrap; }
td { border-top: 1px solid #f0f1f6; padding: 15px 18px; color: #656c83; font-size: 11px; white-space: nowrap; }
td strong, .cell-subtitle { display: block; }
td strong { font-size: 11px; color: #343950; font-weight: 700; }
.cell-subtitle { max-width: 190px; overflow: hidden; text-overflow: ellipsis; color: #a0a5b5; font-size: 10px; margin-top: 5px; }
.order-number { color: var(--primary) !important; }
.status-pill { display: inline-flex; align-items: center; gap: 6px; border-radius: 20px; padding: 6px 9px; font-size: 9px; font-weight: 700; }
.status-pill > span { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
.status-pending { background: #fff4e5; color: #c7832e; }
.status-completed { background: #e8f9f0; color: #249765; }
.status-cancelled { background: #fff0f0; color: #cf555d; }
.status-processing { background: #eaf3ff; color: #4287d5; }
.empty-state { text-align: center; padding: 40px 15px; color: #969bb0; }
.table-footer { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 14px 22px; border-top: 1px solid #eff0f6; color: #a0a5b5; font-size: 10px; }
.text-button { background: transparent; border: 0; color: var(--primary); font-size: 11px; font-weight: 700; }
.page-footer { display: flex; justify-content: space-between; gap: 12px; color: #a6aabc; font-size: 10px; padding: 25px 2px 0; }
.spin { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.login-screen { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: radial-gradient(ellipse at 15% 5%, #eeedff 0, transparent 42%), radial-gradient(ellipse at 90% 90%, #e9f5ff 0, transparent 38%), #f8f9fd; }
.login-card { width: min(420px, 100%); padding: 38px; background: #fff; border: 1px solid #e8eaf2; border-radius: 17px; box-shadow: 0 18px 55px #25254c0d; }
.login-card .brand-mark { margin-bottom: 27px; }
.login-card h1 { font: 800 26px Manrope, sans-serif; letter-spacing: -.8px; margin: 0; }
.login-card > .muted { margin-bottom: 28px; }
.login-card label { display: block; font-size: 11px; font-weight: 700; color: #565d76; margin: 17px 0 8px; }
.login-card input { width: 100%; border: 1px solid #e1e4ee; border-radius: 8px; padding: 12px; outline: none; color: #292e43; font-size: 13px; background: #fff; }
.login-card input:focus { border-color: #8d86ed; box-shadow: 0 0 0 3px #635bdb13; }
.login-button { width: 100%; margin-top: 22px; padding: 13px; }
.login-footnote { color: #a0a5b5; font-size: 10px; text-align: center; margin: 19px 0 0; }
.error-message { color: #c74751; font-size: 12px; margin: 12px 0 0; }
.mobile-backdrop { display: none; }

@media (max-width: 1150px) {
  .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .page-content { padding: 27px 23px; }
  .topbar { padding: 0 23px; }
}
@media (max-width: 760px) {
  .sidebar { position: fixed; z-index: 20; top: 0; bottom: 0; left: 0; transform: translateX(-100%); transition: transform .22s ease; box-shadow: none; }
  .sidebar-open { transform: translateX(0); box-shadow: 10px 0 35px #17172a20; }
  .mobile-backdrop { display: block; position: fixed; inset: 0; z-index: 19; border: 0; background: #17172a70; }
  .mobile-menu, .mobile-close { display: grid; }
  .topbar { height: 78px; padding: 0 16px; }
  .topbar h1 { font-size: 16px; }
  .admin-label, .notification-button, .muted-icon { display: none; }
  .page-content { padding: 25px 15px; }
  .welcome-row { align-items: flex-start; flex-direction: column; }
  .welcome-row h2 { font-size: 22px; }
  .stats-grid { gap: 10px; }
  .stat-card { padding: 14px; }
  .stat-top { font-size: 10px; }
  .stat-value { font-size: 22px; }
  .stat-caption { font-size: 9px; }
  .panel-heading { padding: 19px 15px; }
  .table-toolbar { padding: 0 15px 15px; align-items: flex-start; flex-direction: column; }
  .search-box { width: 100%; }
  th, td { padding: 13px 14px; }
  .table-footer, .page-footer { padding-left: 15px; padding-right: 15px; }
  .page-footer { flex-direction: column; }
  .login-card { padding: 27px; }
}
@media (max-width: 390px) {
  .stats-grid { grid-template-columns: 1fr; }
  .topbar-actions { gap: 7px; }
}


/* Order details panel */
.order-details-backdrop {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  justify-content: flex-end;
  background: rgba(18, 22, 42, 0.42);
  backdrop-filter: blur(2px);
}

.order-details-panel {
  width: min(520px, 100%);
  height: 100%;
  overflow-y: auto;
  padding: 28px;
  background: #fff;
  box-shadow: -12px 0 40px rgba(20, 24, 50, 0.12);
  animation: order-panel-in 0.2s ease-out;
}

.order-details-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 22px;
  border-bottom: 1px solid var(--border);
}

.order-details-header h2 {
  margin: 5px 0;
  font-size: 22px;
  overflow-wrap: anywhere;
}

.order-details-section {
  padding: 22px 0;
  border-bottom: 1px solid var(--border);
}

.order-details-section h3 {
  margin: 0 0 15px;
  font-size: 13px;
}

.order-details-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.order-detail-label {
  display: block;
  margin-bottom: 5px;
  color: #777e93;
  font-size: 11px;
}

.order-detail-value {
  overflow-wrap: anywhere;
  font-size: 13px;
  font-weight: 600;
}

.order-detail-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
  padding: 13px 0;
  border-bottom: 1px solid #f0f1f6;
  font-size: 12px;
}

.order-detail-item:last-child {
  border-bottom: 0;
}

.order-detail-total {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding-top: 18px;
  font-size: 15px;
  font-weight: 800;
}

.order-row-clickable {
  cursor: pointer;
}

.order-row-clickable:focus-visible {
  outline: 2px solid #635bdb;
  outline-offset: -2px;
}

@keyframes order-panel-in {
  from {
    transform: translateX(20px);
    opacity: 0.7;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

@media (max-width: 520px) {
  .order-details-panel {
    padding: 20px;
  }

  .order-details-grid {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  .order-details-panel {
    animation: none;
  }
}


.analytics-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  gap: 20px;
  margin-bottom: 24px;
}

.analytics-card {
  min-width: 0;
  padding: 22px;
  background: var(--card, #fff);
  border: 1px solid var(--border, #e8eaf1);
  border-radius: 16px;
}

.analytics-heading h2 {
  margin: 0 0 6px;
  font-size: 16px;
}

.analytics-heading p {
  margin: 0;
  font-size: 12px;
}

.revenue-chart {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  align-items: end;
  gap: 10px;
  height: 220px;
  margin-top: 22px;
}

.revenue-bar-column {
  display: flex;
  min-width: 0;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.revenue-value {
  max-width: 100%;
  overflow: hidden;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.revenue-bar-track {
  display: flex;
  width: 100%;
  height: 145px;
  align-items: flex-end;
  overflow: hidden;
  border-radius: 6px 6px 0 0;
  background: #f1f2f8;
}

.revenue-bar {
  width: 100%;
  min-height: 0;
  border-radius: 6px 6px 0 0;
  background: #635bdb;
  transition: height 200ms ease;
}

.revenue-day-label {
  color: #777e93;
  font-size: 10px;
  white-space: nowrap;
}

.status-breakdown {
  display: grid;
  gap: 19px;
  margin-top: 26px;
}

.status-breakdown-row {
  display: grid;
  grid-template-columns: 9px 78px minmax(30px, 1fr) 20px;
  align-items: center;
  gap: 9px;
  font-size: 11px;
}

.status-breakdown-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.status-breakdown-label {
  color: #62697e;
}

.status-breakdown-track {
  height: 7px;
  overflow: hidden;
  border-radius: 10px;
  background: #f1f2f8;
}

.status-breakdown-fill {
  height: 100%;
  border-radius: inherit;
}

.status-breakdown-row strong {
  text-align: right;
}

@media (max-width: 900px) {
  .analytics-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {
  .analytics-card {
    padding: 16px;
  }

  .revenue-chart {
    gap: 5px;
  }

  .revenue-value {
    font-size: 8px;
  }

  .status-breakdown-row {
    grid-template-columns: 9px 72px minmax(30px, 1fr) 20px;
    gap: 6px;
  }
}

.settings-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
  padding: 24px;
}

.settings-content h3 {
  margin: 0;
}

.settings-content p {
  margin: 0;
  overflow-wrap: anywhere;
}

.settings-divider {
  width: 100%;
  height: 1px;
  background: #e5e7eb;
  margin: 12px 0;
}